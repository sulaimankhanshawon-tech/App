{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account profile synchronized on sign-in.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "restaurantId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "staffRole": { "type": "string" },
        "activeTableLabel": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "restaurantId", "displayName", "staffRole", "createdAt", "updatedAt"]
    },
    "RoleDefinition": {
      "title": "RoleDefinition",
      "description": "Role-based access permissions for Owner, Manager, Waiter, and Kitchen Staff.",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "code": { "type": "string", "enum": ["OWNER", "MANAGER", "WAITER", "KITCHEN"] },
        "titleEn": { "type": "string" },
        "titleAr": { "type": "string" },
        "permissions": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["restaurantId", "code", "titleEn", "titleAr", "permissions", "updatedAt"]
    },
    "CategoryEntity": {
      "title": "CategoryEntity",
      "description": "Food menu category linked to a default kitchen station.",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "code": { "type": "string" },
        "nameEn": { "type": "string" },
        "nameAr": { "type": "string" },
        "defaultStation": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["restaurantId", "code", "nameEn", "nameAr", "defaultStation", "sortOrder", "active", "updatedAt"]
    },
    "ProductImage": {
      "title": "ProductImage",
      "description": "Cloud-stored compressed dish photograph uploaded by Admin/Manager.",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "productId": { "type": "string" },
        "mimeType": { "type": "string" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "sizeBytes": { "type": "integer" },
        "base64Data": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["restaurantId", "mimeType", "width", "height", "sizeBytes", "base64Data", "uploadedBy", "createdAt", "updatedAt"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Dish or beverage item in the Asil Al Tawooq menu.",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "nameEn": { "type": "string" },
        "nameAr": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "descriptionAr": { "type": "string" },
        "ingredientsEn": { "type": "string" },
        "ingredientsAr": { "type": "string" },
        "allergens": { "type": "array" },
        "category": {
          "type": "string",
          "enum": [
            "CHARCOAL_GRILLS",
            "CHICKEN_TAWOOK",
            "SHAWARMA",
            "RICE_MEALS",
            "SANDWICHES",
            "PASTA",
            "APPETIZERS",
            "SAUCES",
            "COLD_DRINKS",
            "SPECIAL_DEALS"
          ]
        },
        "kitchenStation": {
          "type": "string",
          "enum": ["GRILL", "SHAWARMA", "SANDWICH", "PASTA", "DRINKS", "GENERAL"]
        },
        "spiceLevel": {
          "type": "string",
          "enum": ["MILD", "MEDIUM", "HOT"]
        },
        "portionSize": { "type": "string" },
        "priceSar": { "type": "number" },
        "prepMinutes": { "type": "integer" },
        "available": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "isMealDeal": { "type": "boolean" },
