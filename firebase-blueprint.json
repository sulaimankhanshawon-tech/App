        "offerLabel": { "type": "string" },
        "imageKey": { "type": "string" },
        "imageId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "sizes": { "type": "array" },
        "extras": { "type": "array" },
        "demoData": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "restaurantId",
        "nameEn",
        "nameAr",
        "descriptionEn",
        "category",
        "kitchenStation",
        "spiceLevel",
        "portionSize",
        "priceSar",
        "prepMinutes",
        "available",
        "hidden",
        "featured",
        "imageKey",
        "demoData",
        "createdAt",
        "updatedAt"
      ]
    },
    "RestaurantTable": {
