  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile and assigned table/role metadata."
    },
    "/roles/{roleId}": {
      "schema": { "$ref": "#/entities/RoleDefinition" },
      "description": "RBAC role definitions for Owner, Manager, Waiter, and Kitchen Staff."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/CategoryEntity" },
      "description": "Food categories and default kitchen station mappings."
    },
    "/product_images/{imageId}": {
      "schema": { "$ref": "#/entities/ProductImage" },
      "description": "Cloud-hosted compressed product photographs."
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Restaurant menu dishes, prices in SAR, ingredients, allergens, and kitchen stations."
    },
    "/restaurant_tables/{tableId}": {
      "schema": { "$ref": "#/entities/RestaurantTable" },
      "description": "Dining hall and patio tables with live status, active toggle, and QR payloads."
    },
    "/qr_codes/{qrId}": {
      "schema": { "$ref": "#/entities/TableQrCode" },
      "description": "Unique QR code definitions mapped 1:1 to tables."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders synchronized across Waiter, Kitchen Display, Billing, and Admin."
    },
    "/order_items/{orderItemId}": {
      "schema": { "$ref": "#/entities/OrderItemRecord" },
      "description": "Individual ordered dish line items routed by kitchen station."
    },
    "/kitchen_stations/{stationId}": {
      "schema": { "$ref": "#/entities/KitchenStationEntity" },
      "description": "Kitchen station definitions."
    },
    "/service_requests/{requestId}": {
      "schema": { "$ref": "#/entities/ServiceRequest" },
      "description": "Live customer table service requests."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Verified payment transactions and cash/transfer verification requests."
    },
    "/loyalty_profiles/{userId}": {
      "schema": { "$ref": "#/entities/LoyaltyProfile" },
      "description": "Customer digital loyalty card, points, and rewards."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Customer feedback and star ratings."
    },
    "/game_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/GameSession" },
      "description": "Multiplayer table trivia and food guessing game rooms."
    },
    "/staff/{staffUid}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Staff accounts, role permissions, and performance stats."
    },
    "/restaurant_settings/{settingId}": {
      "schema": { "$ref": "#/entities/RestaurantSettings" },
      "description": "Central restaurant settings, Wi-Fi info, VAT rate, and gateway settings."
