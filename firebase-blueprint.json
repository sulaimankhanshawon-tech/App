        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "restaurantId",
        "orderId",
        "tableNumber",
        "amountSar",
        "vatSar",
        "tipSar",
        "method",
        "splitMode",
        "gatewayProvider",
